# Copy to ~/profitgraph/master-keys.env on the production host (chmod 600) and keep an offline copy: stored credentials
# cannot be decrypted without these keys. Never commit the real file.
# Generate a key with: openssl rand -base64 32
# To rotate, add a new key under a new identifier, make it active and keep the old line (docs/production.md).
Secrets__ActiveKeyId=<key-id>
Secrets__MasterKeys__<key-id>=<base64-encoded-32-byte-key>
