# Copy to ~/profitgraph/.env on the production host (chmod 600) and replace the placeholders (docs/production.md).
# Never commit the real file. deploy/deploy.sh sets PROFITGRAPH_VERSION itself.

# The address the browser opens; Caddy issues its local certificate for it.
PROFITGRAPH_HOST=192.168.8.111

# Generate once, for example: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=<database-password>

# Creates the first Owner on the first start of an empty database; later starts ignore it. Clear both after sign-in.
BOOTSTRAP_OWNER_LOGIN=<owner-login>
BOOTSTRAP_OWNER_PASSWORD=<long-owner-password>

# Off unless the owner turns them on (docs/production.md#switches).
LIVE_TRADING_ENABLED=false
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
STEAM_ENABLED=false
STEAM_MARKET_DATA_CREDENTIAL_ID=
TINVEST_ENABLED=false
# The stored T-Invest credential the market scanner reads with (ADR 0062); empty keeps T-Invest out of the scanner.
TINVEST_SCANNER_CREDENTIAL_ID=
