{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "CsvImport": {
    "BatchSize": 1000,
    "MaxRows": 100000,
    "MaxFileSizeBytes": 10485760,
    "MaxRequestSizeBytes": 12582912,
    "MaxRowLength": 1024,
    "MaxDetailedErrors": 20
  }
}
