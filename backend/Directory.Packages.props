<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>

    <ItemGroup>
        <!-- MediatR stays on 12.5.0, the last Apache-2.0 release; 13.x+ requires a commercial license (ADR 0005). -->
        <!-- Pure-computation indicator library used by the engine replay adapter (ADR 0009). -->
        <PackageVersion Include="FacioQuo.Stock.Indicators" Version="3.0.3" />
        <PackageVersion Include="MediatR" Version="12.5.0" />
        <PackageVersion Include="MediatR.Contracts" Version="2.0.1" />
        <!-- Transitive pin: FluentMigrator brings a vulnerable System.Security.Cryptography.Pkcs 9.0.0. -->
        <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
        <PackageVersion Include="Npgsql" Version="10.0.3" />
        <PackageVersion Include="Dapper" Version="2.1.79" />
        <PackageVersion Include="CsvHelper" Version="33.1.0" />
        <PackageVersion Include="CryptoClients.Net" Version="5.9.0" />
        <PackageVersion Include="Polly.Core" Version="8.4.2" />
        <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
        <PackageVersion Include="FluentMigrator.Runner" Version="8.0.1" />
        <PackageVersion Include="FluentMigrator.Extensions.Postgres" Version="8.0.1" />
        <PackageVersion Include="FluentValidation" Version="12.1.1" />
        <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
        <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
        <!-- Transitive pin: Microsoft.AspNetCore.OpenApi brings a vulnerable Microsoft.OpenApi 2.0.0. -->
        <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
        <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageVersion Include="NUnit" Version="4.6.1" />
        <PackageVersion Include="NUnit.Analyzers" Version="4.14.0" />
        <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
        <PackageVersion Include="NSubstitute" Version="6.0.0" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
        <PackageVersion Include="Shouldly" Version="4.3.0" />
        <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    </ItemGroup>
</Project>
