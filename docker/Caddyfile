# Production entry point (ADR 0053). PROFITGRAPH_HOST is the address the browser opens, an IP or a name on the local
# network. Caddy issues its certificate from its own local CA (tls internal), kept in the caddy_data volume; the owner
# trusts that CA's root certificate on their devices once (docs/production.md). Plain HTTP redirects to HTTPS.
{
	# Browsers send no SNI to an IP address, so the certificate is chosen by this name.
	default_sni {$PROFITGRAPH_HOST}
	skip_install_trust
}

https://{$PROFITGRAPH_HOST} {
	tls internal
	encode zstd gzip

	@backend path /api /api/* /ws/*
	handle @backend {
		# Caddy sets X-Forwarded-For and X-Forwarded-Proto; the API trusts them only from this container's fixed address.
		reverse_proxy api:8080
	}

	handle {
		root * /srv

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		@page not path /assets/*
		header @page Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
